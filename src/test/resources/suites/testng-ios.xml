<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="iOS Suite" parallel="false">

    <listeners>
        <listener class-name="com.testapp.listeners.PlatformTestNgListener"/>
    </listeners>

    <test name="iOS Tests">
        <parameter name="platform" value="ios"/>
        <classes>
            <class name="com.testapp.runners.IOSRunner"/>
        </classes>
    </test>

</suite>

