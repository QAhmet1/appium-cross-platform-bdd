<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Cross-Platform Parallel Suite" parallel="tests" thread-count="2">

    <test name="Android Parallel Test">
        <parameter name="platform" value="android"/>
        <classes>
            <class name="com.testapp.runners.Runner"/>
        </classes>
    </test>

    <test name="iOS Parallel Test">
        <parameter name="platform" value="ios"/>
        <classes>
            <class name="com.testapp.runners.Runner"/>
        </classes>
    </test>

</suite>